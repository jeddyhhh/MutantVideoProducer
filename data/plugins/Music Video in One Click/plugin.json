{
  "id": "music-video",
  "name": "Music Video in One Click",
  "version": "1.0",
  "author": "Mutant Video Producer",
  "description": "Put a song on the timeline and some footage in Project Media: this finds the song's beats, cuts a montage of the footage on them (a new track on top) and rolls Director's Dice over it for a look.",
  "commands": [
    {
      "label": "Music Video in One Click...",
      "script": "main.js",
      "fields": [
        { "id": "style", "label": "Look", "type": "choice", "choices": ["measured", "restless", "riot"],
          "labels": ["Measured", "Restless", "Riot"], "default": "restless" },
        { "id": "every", "label": "Cut every", "type": "choice", "choices": ["1", "2", "4", "8"],
          "labels": ["Beat", "2 beats", "Bar (4 beats)", "2 bars"], "default": "2" },
        { "id": "from", "label": "From (seconds)", "type": "number", "default": 0, "min": 0, "max": 86400 },
        { "id": "to", "label": "To (seconds, 0: the end)", "type": "number", "default": 0, "min": 0, "max": 86400 },
        { "id": "intensity", "label": "How strong the look is (0 to 1)", "type": "number", "default": 0.6, "min": 0, "max": 1 },
        { "id": "seed", "label": "Seed (another number, another cut)", "type": "number", "default": 1, "min": 0, "max": 100000 }
      ]
    }
  ]
}
